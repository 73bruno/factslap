{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api"
        },
        {
            "source": "/c/(.*)",
            "destination": "/api"
        },
        {
            "source": "/((?!api|c/|_next|static|.*\\..*).*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/index.py": {
            "includeFiles": "factslap/**",
            "maxDuration": 60
        }
    }
}
