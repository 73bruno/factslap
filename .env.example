# Copy to .env and fill in. Only OPENAI_API_KEY is required: every other service is optional
# and its stage switches off (or falls back) when the key is missing.

# LLM and embeddings
OPENAI_API_KEY=

# Sources (free keys)
SEMANTIC_SCHOLAR_API_KEY=        # https://www.semanticscholar.org/product/api (anonymous access is heavily throttled)
OPENALEX_API_KEY=                # https://openalex.org (without it the per-IP daily budget runs out)
GOOGLE_API_KEY=                  # Google Fact Check Tools API

# Own passage index and semantic cache (run supabase/migrations/0001_index.sql first)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Limits, result cache and share links (Upstash Redis).
# Required in production: on Vercel the API refuses checks without it. Leave empty locally for no limits.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
IP_HASH_SALT=                    # any long random string; IPs are only stored as salted hashes
# FACTSLAP_COOLDOWN_SECONDS=3600   # one check per person per hour
# FACTSLAP_DAILY_CHECKS_TOTAL=50   # for everyone together
# FACTSLAP_MAX_IN_FLIGHT=4
# LIMIT_OPENAI=2                   # daily OpenAI budget in USD
# FACTSLAP_ALLOWED_ORIGINS=https://www.factslap.app,https://factslap.app,http://localhost:5173

# Model overrides
# FACTSLAP_FAST_MODEL=gpt-5.6-luna            # plan, rerank
# FACTSLAP_READER_MODEL=gpt-5.6-terra         # stance
# FACTSLAP_ANSWER_MODEL=gpt-5.6-terra         # answer, tone
# FACTSLAP_FALLBACK_MODEL=gpt-5.4-mini
# FACTSLAP_EMBEDDING_MODEL=text-embedding-3-small
# FACTSLAP_LLM_RERANK=1                       # 0: fused ranking only, no LLM reranker
